{
  "name": "@martian/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Martian MCP servers, customer connector and control-plane gateway",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "connector": "node dist/connector.js",
    "gateway": "node dist/gateway.js",
    "dev:gateway": "tsx src/gateway.ts",
    "dev:connector": "tsx src/connector.ts"
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.1155.0",
    "@aws-sdk/client-cloudwatch": "^3.1155.0",
    "@aws-sdk/client-cost-explorer": "^3.1155.0",
    "@aws-sdk/client-ec2": "^3.1155.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1155.0",
    "@aws-sdk/client-rds": "^3.1155.0",
    "@aws-sdk/client-sts": "^3.1155.0",
    "@aws-sdk/credential-providers": "^3.1155.0",
    "@azure/arm-compute": "^25.3.0",
    "@azure/arm-monitor": "^8.0.0",
    "@azure/identity": "^4.14.0",
    "@google-cloud/compute": "^7.9.0",
    "@google-cloud/monitoring": "^6.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pino": "^10.4.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
