# docker compose settings. Copy to .env and change anything marked REQUIRED for a real install.

# Database passwords (owner runs migrations; app role is what the API and worker use).
MARTIAN_OWNER_DB_PASSWORD=martian
MARTIAN_APP_DB_PASSWORD=martian

# REQUIRED outside local testing: 32+ random characters each (openssl rand -hex 32).
MARTIAN_SESSION_SECRET=
MARTIAN_INTERNAL_TOKEN=
# 32 random bytes, base64 (openssl rand -base64 32). Or set MARTIAN_KMS_KEY_ID instead.
MARTIAN_ENCRYPTION_KEY=

# Claude. Without a key Martian uses its deterministic offline planner.
ANTHROPIC_API_KEY=
MARTIAN_ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional SSO (WorkOS).
MARTIAN_WORKOS_API_KEY=
MARTIAN_WORKOS_CLIENT_ID=

# Demo tenant + sandbox connector. Set false for a real install, then create your
# organization with: docker compose run --rm api martian-seed --org "Acme" --email you@acme.com --password '...'
MARTIAN_SEED_DEMO=true

# Production mode refuses to start with dev secrets; it also requires HTTPS cookies.
MARTIAN_ENV=development
MARTIAN_COOKIE_SECURE=false
MARTIAN_WEB_ORIGIN=http://localhost:8080
MARTIAN_HTTP_PORT=8080
